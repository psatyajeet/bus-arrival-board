# Request a personal key at https://511.org/open-data/token
TRANSIT_511_TOKEN=
BOARD_BADGE=38
BOARD_TITLE=BUS
# 511 agency ID, public stop code, and exact LineRef for each row.
BOARD_ROW1_AGENCY=SF
BOARD_ROW1_STOP=
BOARD_ROW1_ROUTE=38
BOARD_ROW1_LABEL=EAST
BOARD_ROW2_AGENCY=SF
BOARD_ROW2_STOP=
BOARD_ROW2_ROUTE=38
BOARD_ROW2_LABEL=WEST
# Use 150 seconds with the standard 511 quota. See the README for faster polling.
BOARD_POLL_SECONDS=150
